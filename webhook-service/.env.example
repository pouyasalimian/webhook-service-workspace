# Application
APP_PORT=3000
APP_ENV=development
NODE_ENV=development

# Database
DATABASE_URL=postgresql://webhook:local-dev-password@localhost:5432/webhook_service?schema=public

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Delivery runtime defaults
WEBHOOK_HTTP_TIMEOUT_MS=10000
WEBHOOK_WORKER_CONCURRENCY=2
OUTBOX_POLL_INTERVAL_MS=1000
RECONCILIATION_INTERVAL_MS=30000
