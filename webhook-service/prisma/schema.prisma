generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WebhookEventType {
  PAYMENT_COMPLETED

  @@map("webhook_event_type")
}

enum WebhookStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED

  @@map("webhook_status")
}

enum WebhookAttemptStatus {
  PENDING
  SUCCESS
  FAILED

  @@map("webhook_attempt_status")
}

enum WebhookFailureReason {
  TIMEOUT
  NETWORK_ERROR
  HTTP_ERROR
  INVALID_RESPONSE
  INTERNAL_ERROR

  @@map("webhook_failure_reason")
}

model WebhookSubscription {
  id        String           @id @default(uuid()) @db.Uuid
  eventType WebhookEventType @map("event_type")
  endpoint      String           @db.VarChar(2048)
  signingSecret String           @map("signing_secret") @db.VarChar(64)
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?        @map("deleted_at") @db.Timestamptz(6)

  webhooks Webhook[]

  @@index([eventType, isActive, deletedAt])
  @@index([createdAt])
  @@map("webhook_subscriptions")
}

model WebhookEvent {
  id            String           @id @default(uuid()) @db.Uuid
  sourceEventId String           @unique(map: "webhook_events_source_event_id_key") @map("source_event_id") @db.VarChar(255)
  eventType     WebhookEventType @map("event_type")
  payload       Json
  occurredAt    DateTime?        @map("occurred_at") @db.Timestamptz(6)
  receivedAt    DateTime         @default(now()) @map("received_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  webhooks Webhook[] @relation("WebhookEventDeliveries")

  @@index([eventType, receivedAt])
  @@map("webhook_events")
}

model Webhook {
  id                  String           @id @default(uuid()) @db.Uuid
  eventId             String           @map("event_id") @db.Uuid
  subscriptionId      String           @map("subscription_id") @db.Uuid
  eventType           WebhookEventType @map("event_type")
  endpoint            String           @db.VarChar(2048)
  status              WebhookStatus    @default(PENDING)
  payload             Json
  attemptCount        Int              @default(0) @map("attempt_count")
  failureReason       String?          @map("failure_reason") @db.Text
  nextAttemptAt       DateTime?        @map("next_attempt_at") @db.Timestamptz(6)
  lastAttemptAt       DateTime?        @map("last_attempt_at") @db.Timestamptz(6)
  succeededAt         DateTime?        @map("succeeded_at") @db.Timestamptz(6)
  processingStartedAt DateTime?        @map("processing_started_at") @db.Timestamptz(6)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  event        WebhookEvent        @relation("WebhookEventDeliveries", fields: [eventId], references: [id], onDelete: Restrict)
  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  attempts     WebhookDelivery[]
  outbox       OutboxMessage?

  @@unique([subscriptionId, eventId])
  @@index([status, nextAttemptAt])
  @@index([subscriptionId, createdAt])
  @@index([eventId])
  @@map("webhooks")
}

model WebhookDelivery {
  id               String                @id @default(uuid()) @db.Uuid
  webhookId        String                @map("webhook_id") @db.Uuid
  attemptNumber    Int                   @map("attempt_number")
  endpointAudit    String                @map("endpoint_audit") @db.VarChar(2048)
  status           WebhookAttemptStatus  @default(PENDING)
  failureReason    WebhookFailureReason? @map("failure_reason")
  failureDetails   String?               @map("failure_details") @db.Text
  clientHttpStatus Int?                  @map("client_http_status")
  responseBody     String?               @map("response_body") @db.Text
  durationMs       Int?                  @map("duration_ms")
  startedAt        DateTime              @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?             @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Restrict)

  @@unique([webhookId, attemptNumber])
  @@index([webhookId, createdAt])
  @@index([status, startedAt])
  @@map("webhook_deliveries")
}

model OutboxMessage {
  id          String    @id @default(uuid()) @db.Uuid
  webhookId   String    @unique(map: "outbox_messages_webhook_id_key") @map("webhook_id") @db.Uuid
  type        String    @db.VarChar(100)
  payload     Json
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Restrict)

  @@index([publishedAt, createdAt])
  @@map("outbox_messages")
}
